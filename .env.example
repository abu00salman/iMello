# iMello configuration reference. Copy to .env (never commit .env).
# Generate secrets with: openssl rand -hex 32

# ── Public URLs ──────────────────────────────────────────────
IMELLO_DOMAIN=imello.example.com            # web client
IMELLO_API_DOMAIN=api.imello.example.com    # policy API
IMELLO_MATRIX_DOMAIN=matrix.imello.example.com
MATRIX_SERVER_NAME=imello.example.com       # permanent: part of every user ID (@name:server)

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://imello:change-me@postgres:5432/imello

# ── Secrets (server-side only) ──────────────────────────────
SYNAPSE_REGISTRATION_SHARED_SECRET=
POLICY_INTERNAL_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=

# ── API ─────────────────────────────────────────────────────
CORS_ORIGINS=https://imello.example.com
PUBLIC_WEB_URL=https://imello.example.com
REGISTRATION_RATE_LIMIT=5
TRUST_PROXY=true
LOG_LEVEL=info

# ── Web client build (public, not secret) ───────────────────
VITE_API_URL=https://api.imello.example.com
VITE_HOMESERVER_URL=https://matrix.imello.example.com
