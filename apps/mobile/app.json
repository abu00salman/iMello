{
  "expo": {
    "name": "Wanas",
    "slug": "wanas",
    "scheme": "wanas",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Stay Close. Feel Connected. A private, ad-free, end-to-end encrypted family messenger.",
    "owner": "abu00salman",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FB",
      "dark": {
        "backgroundColor": "#0E1015"
      }
    },
    "ios": {
      "bundleIdentifier": "com.abu00salman.wanas",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["en", "ar"],
        "NSMicrophoneUsageDescription": "Wanas uses the microphone to record voice messages. Recordings are encrypted before they leave your phone.",
        "NSCameraUsageDescription": "Wanas uses the camera for video calls and when you choose to send a photo.",
        "NSPhotoLibraryUsageDescription": "Wanas lets you choose photos to send. Photos are encrypted before they leave your phone."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.abu00salman.wanas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F64AC"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-audio",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-notifications",
        {
          "color": "#1F64AC",
          "sounds": [
            "./assets/sounds/incoming.wav",
            "./assets/sounds/ping_taps.wav",
            "./assets/sounds/ping_knock.wav",
            "./assets/sounds/ping_bell.wav",
            "./assets/sounds/ping_chirp.wav",
            "./assets/sounds/ping_drum.wav"
          ]
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "apiUrl": "https://imello-api.abu00salman.com",
      "forcesRTL": false,
      "webUrl": "https://abu00salman.github.io/Wanas/app/"
    }
  }
}
