{
  "name": "@imello/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc -p engine/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "build:engine": "vite build --config vite.engine.config.mjs && node scripts/check-engine-script.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@imello/core": "workspace:*",
    "@imello/localization": "workspace:*",
    "@imello/ui": "workspace:*",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "matrix-js-sdk": "45.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
