# Used behind Cloudflare Tunnel: Cloudflare terminates HTTPS, cloudflared forwards plain HTTP to Caddy.
# Caddy still enforces the path rules (/internal and the Synapse admin API are never public).
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

http://{$IMELLO_API_DOMAIN} {
	@internal path /internal/*
	respond @internal 404
	reverse_proxy api:8787
}

http://{$IMELLO_MATRIX_DOMAIN} {
	@admin path /_synapse/admin/*
	respond @admin 404
	reverse_proxy /_matrix/* synapse:8008
	reverse_proxy /_synapse/client/* synapse:8008
}
